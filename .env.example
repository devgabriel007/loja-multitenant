APP_NAME="Loja Multi-tenant"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=loja_multitenant
DB_USERNAME=root
DB_PASSWORD=

# Para SQLite (desenvolvimento rápido):
# DB_CONNECTION=sqlite
# DB_DATABASE=/caminho/absoluto/para/database/database.sqlite

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# ─── MULTITENANCY ───────────────────────────────────────────────
# Modo de resolução do tenant:
# "porta"   → php artisan serve (8000=empresa_a, 8001=empresa_b)
# "dominio" → por domínio em produção
# "parametro" → ?tenant=b na URL
TENANT_MODO=porta
